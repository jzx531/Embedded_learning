					remote-endpoint = <0x94>;
				};
				endpoint@3 {
					name = "endpoint";
					phandle = <0x1a>;
					reg = <0x3>;
					remote-endpoint = <0x95>;
				};
			};
			port@1 {
				#address-cells = <0x1>;
				#size-cells = <0x0>;
				name = "port";
				reg = <0x1>;
				rockchip,plane-mask = <0x15>;
				rockchip,primary-plane = <0x4>;
				endpoint@0 {
					name = "endpoint";
					phandle = <0x17>;
					reg = <0x0>;
					remote-endpoint = <0x96>;
				};
				endpoint@1 {
					name = "endpoint";
					phandle = <0xa5>;
					reg = <0x1>;
					remote-endpoint = <0x97>;
				};
				endpoint@2 {
					name = "endpoint";
					phandle = <0xab>;
					reg = <0x2>;
					remote-endpoint = <0x98>;
				};
				endpoint@3 {
					name = "endpoint";
					phandle = <0xa9>;
					reg = <0x3>;
					remote-endpoint = <0x99>;
				};
				endpoint@4 {
					name = "endpoint";
					phandle = <0x1b>;
					reg = <0x4>;
					remote-endpoint = <0x9a>;
				};
				endpoint@5 {
					name = "endpoint";
					phandle = <0x37>;
					reg = <0x5>;
					remote-endpoint = <0x9b>;
				};
			};
			port@2 {
				#address-cells = <0x1>;
				#size-cells = <0x0>;
				name = "port";
				reg = <0x2>;
				rockchip,plane-mask = <0x8>;
				rockchip,primary-plane = <0x3>;
				endpoint@0 {
					name = "endpoint";
					phandle = <0x35>;
					reg = <0x0>;
					remote-endpoint = <0x9c>;
				};
				endpoint@1 {
					name = "endpoint";
					phandle = <0x1d>;
					reg = <0x1>;
					remote-endpoint = <0x9d>;
				};
				endpoint@2 {
					name = "endpoint";
					phandle = <0x1c>;
					reg = <0x2>;
					remote-endpoint = <0x9e>;
				};
			};
		};
	};
	watchdog@fe600000 {
		clock-names = "tclk", "pclk";
		clocks = <0x24 0x116 0x24 0x115>;
		compatible = "snps,dw-wdt";
		interrupts = <0x0 0x95 0x4>;
		name = "watchdog";
		reg = <0x0 0xfe600000 0x0 0x100>;
		status = "okay";
	};
	wireless-bluetooth {
		BT,power_gpio = <0x8a 0x0 0x0>;
		BT,wake_gpio = <0x8a 0x1 0x0>;
		BT,wake_host_irq = <0x8a 0x2 0x0>;
		clock-names = "ext_clock";
		clocks = <0x146 0x1>;
		compatible = "bluetooth-platdata";
		name = "wireless-bluetooth";
		pinctrl-0 = <0x149>;
		pinctrl-1 = <0x14a>;
		pinctrl-names = "default", "rts_gpio";
		status = "okay";
		uart_rts_gpios = <0xbf 0x9 0x1>;
	};
	wireless-wlan {
		WIFI,host_wake_irq = <0x8a 0x1c 0x0>;
		WIFI,poweren_gpio = <0x8a 0x1d 0x0>;
		compatible = "wlan-platdata";
		name = "wireless-wlan";
		pinctrl-0 = <0x148>;
		pinctrl-names = "default";
		rockchip,grf = <0x3a>;
		status = "okay";
		wifi_chip_type = "rtl8822cs";
	};
	xin24m {
		#clock-cells = <0x0>;
		clock-frequency = <0x16e3600>;
		clock-output-names = "xin24m";
		compatible = "fixed-clock";
		name = "xin24m";
	};
	xin32k {
		#clock-cells = <0x0>;
		clock-frequency = <0x8000>;
		clock-output-names = "xin32k";
		compatible = "fixed-clock";
		name = "xin32k";
		pinctrl-0 = <0x23>;
		pinctrl-names = "default";
	};
	xpcs-gmac0-clock {
		#clock-cells = <0x0>;
		clock-frequency = <0x7735940>;
		clock-output-names = "clk_gmac0_xpcs_mii";
		compatible = "fixed-clock";
		name = "xpcs-gmac0-clock";
	};
	xpcs-gmac1-clock {
		#clock-cells = <0x0>;
		clock-frequency = <0x7735940>;
		clock-output-names = "clk_gmac1_xpcs_mii";
		compatible = "fixed-clock";
		name = "xpcs-gmac1-clock";
	};
};
