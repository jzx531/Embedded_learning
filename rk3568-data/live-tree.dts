/dts-v1/;

// Exported from captured runtime data; phandles are numeric.
/ {
	#address-cells = <0x2>;
	#size-cells = <0x2>;
	compatible = "rockchip,rk3568-kickpi-k1a", "rockchip,rk3568";
	interrupt-parent = <0x1>;
	model = "Rockchip RK3568 KICKPI K1A Board";
	name = [00];
	serial-number = "522550335edea2ab";
	adc-keys {
		compatible = "adc-keys";
		io-channel-names = "buttons";
		io-channels = <0x139 0x0>;
		keyup-threshold-microvolt = <0x1b7740>;
		name = "adc-keys";
		poll-interval = <0x64>;
