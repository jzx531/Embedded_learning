	cpuinfo {
		compatible = "rockchip,cpuinfo";
		name = "cpuinfo";
		nvmem-cell-names = "id", "cpu-version", "cpu-code";
		nvmem-cells = <0x10 0x11 0x12>;
	};
	cpus {
		#address-cells = <0x2>;
		#size-cells = <0x0>;
		name = "cpus";
		cpu@0 {
			#cooling-cells = <0x2>;
			clocks = <0x2 0x0>;
			compatible = "arm,cortex-a55";
			cpu-idle-states = <0x4>;
			cpu-supply = <0x5>;
			device_type = "cpu";
			dynamic-power-coefficient = <0xbb>;
			enable-method = "psci";
			name = "cpu";
			operating-points-v2 = <0x3>;
			phandle = <0xc>;
			reg = <0x0 0x0>;
		};
		cpu@100 {
