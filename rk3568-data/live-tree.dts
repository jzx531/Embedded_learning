			compatible = "arm,cortex-a55";
			cpu-idle-states = <0x4>;
			device_type = "cpu";
			enable-method = "psci";
			name = "cpu";
			operating-points-v2 = <0x3>;
			phandle = <0xf>;
			reg = <0x0 0x300>;
		};
		idle-states {
			entry-method = "psci";
			name = "idle-states";
			cpu-sleep {
				arm,psci-suspend-param = <0x10000>;
				compatible = "arm,idle-state";
				entry-latency-us = <0x64>;
				exit-latency-us = <0x78>;
